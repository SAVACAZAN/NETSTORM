Your Priest's blood has been spilled on 
the Altar of <c>{param.1}.</c> 

<?{param.2}>
$Timeout=15,DoNothing,0
$Button=OK,DoNothing,0
</?>
<?!{param.2}>
$Timeout=15,DoNothing,0
$Button=Leave Battle,LeaveBattle,1
$Button=Keep Watching,DoNothing,0
</?>

[***********************************************************]
[MultiplayerOtherPriestDead]
