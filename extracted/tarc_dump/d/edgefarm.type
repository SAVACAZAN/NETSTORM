typename efarm constructor
typeflags edgefarm matchframe dropBlocking walkBlocking mayDropOnRim;
{
	description="Edge Farm";
	class="Defense";
	theme = "sun";
	level = 1;

	zorder = "zoEDGEFARM"; 
	foot_x = 1;
	foot_y = 1;
	damageEffect = 1;
}

// IMPORTANT! These frame counts are take PRECISELY from the isle.type
// file. The program expects to be able to do a perfect matching between
// the island frames and these frames. Of course, this means that the AA
// frames needs filler, so I use rgrass.gif, and instead of efarm.gif
// we're using efarm.gif. -Ken

// Filled pieces
AA01 : default: "rgrass.gif" #0 ;
AA02 : : "rgrass.gif" #1 ;
AA03 : : "rgrass.gif" #2 ;
AA04 : : "rgrass.gif" #3 ;
AA05 : : "rgrass.gif" #4 ;
AA06 : : "rgrass.gif" #5 ;

// Inside Corners
AB01 : rim fringe  : "efarm.gif" #17 ;
AB02 : rim fringe  : "efarm.gif" #29 ;
AC01 : rim : "efarm.gif" #33 ;
AC02 : rim : "efarm.gif" #34 ;
AD01 : rim : "efarm.gif" #35 ;
AD02 : rim : "efarm.gif" #36 ;
AE01 : rim fringe : "efarm.gif" #18 ;
AE02 : rim fringe : "efarm.gif" #30 ;

